<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_vertical">
    <TextView
        android:id="@+id/mGoaleeName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="20dp"
        android:layout_weight="1"
        android:text="Goalee name"/>

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:textSize="13dp"
        android:layout_weight="1"
        android:text="1P"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:textSize="13dp"
        android:layout_weight="1"
        android:text="2P"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:textSize="13dp"
        android:layout_weight="1"
        android:text="3P"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:textSize="13dp"
        android:layout_weight="1"
        android:text="Total"/>


</LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/mP1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1">
            <ImageButton
                android:id="@+id/mP1Up"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:src="@mipmap/up"/>
            <TextView
                android:id="@+id/mP1Goalee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:textSize="30dp"
                android:text="0"/>
            <ImageButton
                android:id="@+id/mP1Down"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:src="@mipmap/down"/>

        </LinearLayout>
        <LinearLayout
            android:id="@+id/mP2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1">
            <ImageButton
                android:id="@+id/mP2Up"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:src="@mipmap/up"/>
            <TextView
                android:id="@+id/mP2Goalee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:textSize="30dp"
                android:text="0"/>
            <ImageButton
                android:id="@+id/mP2Down"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:src="@mipmap/down"/>

        </LinearLayout>
        <LinearLayout
            android:id="@+id/mP3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1">
            <ImageButton
                android:id="@+id/mP3Up"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:src="@mipmap/up"/>
            <TextView
                android:id="@+id/mP3Goalee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:textSize="30dp"
                android:text="0"/>
            <ImageButton
                android:id="@+id/mP3Down"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:src="@mipmap/down"/>

        </LinearLayout>

        <TextView
            android:id="@+id/mTotal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="0"
            android:textSize="30dp" />
    </LinearLayout>
</LinearLayout>